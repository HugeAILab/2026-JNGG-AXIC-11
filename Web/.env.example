# QCheck 환경변수 예시 (TODO.md 12.1)
#   cp .env.example .env  후 값을 채운다.  .env 는 Git 에 올리지 않는다 (.gitignore 등록됨)

# ── 웹 서버 ──────────────────────────────────────────
# 로컬 개발은 비워 둔다. 프록시가 접두사를 지우든 남기든 앱이 알아서 처리한다 (/healthz 로 확인)
ROOT_PATH=
HOST=0.0.0.0
PORT=8501

# 세션 서명 키: 서버에서는 반드시 긴 임의 문자열로 바꾼다
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE=weldsight_session
# https 외부 URL 에서는 true. 로컬 http://127.0.0.1 개발에서만 false (true 면 http 에서 로그인이 유지되지 않음)
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE=28800

# ── 데이터 (31-Web 기준 상대 경로, Git 제외) ─────────────
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
# 썸네일·모델 A 원본 응답(.json.gz). 비우면 DATA_DIR(data) 아래 thumbs/ · results/
THUMB_DIR=
RESULT_DIR=
# 사진 업로드 1회 최대 장수
UPLOAD_MAX_FILES=20
# 샘플 데이터 기준일 YYYY-MM-DD. 비우면 시드 실행일
SEED_BASE_DATE=

# ── 원 페이지 푸터 ────────────────────────────────────
TEAM_NAME="여순서 11"
TEAM_DESC="여수·순천·서울, 11팀"
GITHUB_URL=

# ── AI 파이프라인: 모델 A 선별 → 용접이면 모델 B → RAG → 설명·원인·방지 (3단계: A·B 판정 / 5단계: RAG·설명) ──
AI_MODE=mock                        # live | mock (mock 이면 모든 단계를 모의 모델로, 화면에 '모의 판정' 표시)

# 모델 A: AIStream LNG Tank Quality Inspection (MaskDINO 영역 분할, 32-Web 과 같은 값)
SEGMENTATION_BASE_URL=[[SERVICE_URL]]
SEGMENTATION_TIMEOUT=180

# 모델 B: 용접 상세 분석 API (개발 중 — 비워 두면 B 단계를 건너뜀)
MODEL_B_URL=
MODEL_B_API_KEY=
MODEL_B_TIMEOUT=60
MODEL_B_THRESHOLD=0.5
# 실제 B 가 없을 때(live + MODEL_B_URL 비어 있음) 모의 B 로 흐름을 볼지 (화면에 '모의' 표시). 기본 false = 건너뜀
MODEL_B_MOCK=false
# 모의 모델의 가짜 처리 시간 배수(초 단위, 진행률 화면 확인용). 0 이면 즉시
MOCK_DELAY=1.0

# (선택) 모델 A 와 같은 응답 형식의 개선 모델
IMPROVED_URL=

# AgentStream: RAG · 설명·원인·방지 · 보고서
AGENTSTREAM_BASE_URL=
AGENTSTREAM_API_KEY=
AGENTSTREAM_WORKSPACE_ID=
AGENTSTREAM_CHATBOT_ID=
AGENTSTREAM_RAG_CHATBOT_ID=

# 불량 분석의 AgentStream 응답 제한 시간(초). 연결 실패 시 유형 가이드 초안으로 대체한다.
RAG_TIMEOUT=30
